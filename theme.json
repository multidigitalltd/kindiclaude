{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "768px",
      "wideSize": "1440px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "custom": true,
      "customGradient": true,
      "palette": [
        { "slug": "background", "name": "Background", "color": "oklch(1 0 0)" },
        { "slug": "surface", "name": "Surface", "color": "oklch(0.985 0.006 240)" },
        { "slug": "foreground", "name": "Foreground", "color": "oklch(0.22 0.04 265)" },
        { "slug": "brand-red", "name": "Brand Red", "color": "oklch(0.58 0.21 27)" },
        { "slug": "brand-red-dark", "name": "Brand Red Dark", "color": "oklch(0.49 0.21 27)" },
        { "slug": "brand-red-soft", "name": "Brand Red Soft", "color": "oklch(0.93 0.05 27)" },
        { "slug": "brand-blue", "name": "Brand Blue", "color": "oklch(0.55 0.18 245)" },
        { "slug": "brand-blue-soft", "name": "Brand Blue Soft", "color": "oklch(0.92 0.05 240)" },
        { "slug": "brand-navy", "name": "Brand Navy", "color": "oklch(0.32 0.16 258)" },
        { "slug": "brand-navy-dark", "name": "Brand Navy Dark", "color": "oklch(0.22 0.13 258)" },
        { "slug": "brand-yellow", "name": "Brand Yellow", "color": "oklch(0.86 0.17 91)" },
        { "slug": "muted", "name": "Muted", "color": "oklch(0.96 0.005 95)" },
        { "slug": "muted-foreground", "name": "Muted Foreground", "color": "oklch(0.45 0.02 265)" },
        { "slug": "border", "name": "Border", "color": "oklch(0.92 0.008 95)" },
        { "slug": "white", "name": "White", "color": "oklch(1 0 0)" }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "sans",
          "name": "Ploni",
          "fontFamily": "'Ploni ML v2 AAA', 'Ploni', system-ui, -apple-system, 'Segoe UI', sans-serif"
        },
        {
          "slug": "display",
          "name": "Ploni Yad",
          "fontFamily": "'Ploni Yad v2 AAA', 'Ploni Yad', 'Ploni ML v2 AAA', system-ui, sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "xs", "name": "XS", "size": "0.75rem", "fluid": false },
        { "slug": "sm", "name": "Small", "size": "0.875rem", "fluid": false },
        { "slug": "base", "name": "Base", "size": "1rem", "fluid": false },
        { "slug": "lg", "name": "Large", "size": "1.125rem", "fluid": false },
        { "slug": "xl", "name": "XL", "size": "1.25rem", "fluid": false },
        { "slug": "2xl", "name": "2XL", "size": "1.5rem", "fluid": { "min": "1.375rem", "max": "1.5rem" } },
        { "slug": "3xl", "name": "3XL", "size": "1.875rem", "fluid": { "min": "1.5rem", "max": "1.875rem" } },
        { "slug": "4xl", "name": "4XL", "size": "2.25rem", "fluid": { "min": "1.875rem", "max": "2.25rem" } },
        { "slug": "5xl", "name": "5XL", "size": "3rem", "fluid": { "min": "2.25rem", "max": "3rem" } }
      ],
      "customFontSize": true,
      "fontStyle": true,
      "fontWeight": true,
      "lineHeight": true,
      "letterSpacing": true
    },
    "spacing": {
      "units": ["px", "rem", "em", "%", "vw", "vh"],
      "spacingScale": { "steps": 0 },
      "spacingSizes": [
        { "slug": "10", "name": "1", "size": "0.25rem" },
        { "slug": "20", "name": "2", "size": "0.5rem" },
        { "slug": "30", "name": "3", "size": "0.75rem" },
        { "slug": "40", "name": "4", "size": "1rem" },
        { "slug": "50", "name": "6", "size": "1.5rem" },
        { "slug": "60", "name": "8", "size": "2rem" },
        { "slug": "70", "name": "12", "size": "3rem" },
        { "slug": "80", "name": "16", "size": "5rem" }
      ]
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "shadow": {
      "defaultPresets": false,
      "presets": [
        { "slug": "card", "name": "Card", "shadow": "0 2px 8px -2px oklch(0 0 0 / 0.06), 0 8px 24px -8px oklch(0 0 0 / 0.08)" },
        { "slug": "pop", "name": "Pop", "shadow": "0 20px 40px -12px oklch(0.58 0.21 27 / 0.18)" }
      ]
    },
    "custom": {
      "radius": {
        "base": "0.75rem",
        "sm": "0.5rem",
        "md": "0.625rem",
        "lg": "0.75rem",
        "xl": "1rem",
        "2xl": "1.25rem",
        "3xl": "1.5rem"
      },
      "brand": {
        "red-raw": "0.58 0.21 27"
      }
    },
    "useRootPaddingAwareAlignments": true
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--surface)",
      "text": "var(--wp--preset--color--foreground)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--sans)",
      "fontSize": "var(--wp--preset--font-size--base)",
      "lineHeight": "1.6",
      "fontWeight": "400"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--display)",
          "fontWeight": "700",
          "lineHeight": "1.1"
        },
        "color": { "text": "var(--wp--preset--color--brand-navy)" }
      },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--5xl)" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--4xl)" } },
      "h3": { "typography": { "fontSize": "var(--wp--preset--font-size--3xl)" } },
      "link": {
        "color": { "text": "var(--wp--preset--color--brand-red)" },
        "typography": { "textDecoration": "none" },
        ":hover": { "color": { "text": "var(--wp--preset--color--brand-red-dark)" } }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--brand-red)",
          "text": "var(--wp--preset--color--white)"
        },
        "border": { "radius": "var(--wp--custom--radius--xl)" },
        "typography": { "fontWeight": "700" },
        "spacing": { "padding": { "top": "0.75rem", "bottom": "0.75rem", "left": "1.5rem", "right": "1.5rem" } },
        ":hover": { "color": { "background": "var(--wp--preset--color--brand-red-dark)" } }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": [
    { "name": "page-no-title", "title": "Page (No Title)", "postTypes": ["page"] }
  ]
}
